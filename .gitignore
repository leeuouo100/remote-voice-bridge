__pycache__/
*.py[cod]
*.log
.DS_Store
.venv/
venv/

# 构建产物（安装包通过 GitHub Release 分发，不进仓库）
# 用通配：本地验证时可能输出到 dist_v2/ build_v2/ 等临时目录
build*/
dist*/
installer/
*.spec.bak

# 控制台验收截图（tools/check_ui.js 的产物）
# 截图里会带本机真实路径（如 C:\Users\<用户名>\AppData\...），不入库
_shot*.png

# 排查时的临时产物（看日志/等构建时随手重定向出来的），不入库
_tmp*
_w.txt
_ci.log
_chk.txt

# 本机 agent 的工作记忆（.workbuddy/memory/*.md）—— 属于工作区数据，不是项目源码。
# 显式忽略：它就在仓库目录里躺着，一次 `git add -A` 就会连人带事一起提交出去。
.workbuddy/
